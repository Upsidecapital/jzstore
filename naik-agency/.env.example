# ─── WhatsApp Business Cloud API (Meta) ────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=          # Your custom string for webhook verification (make it random)

# ─── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Payment — choose one to start ──────────────────────────────────────────────
PAYMENT_GATEWAY=toyyibpay      # Options: toyyibpay | ipay88

# Toyyibpay (recommended for Malaysian SMBs — free setup, FPX native)
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# iPay88 (alternative — larger merchants)
IPAY88_MERCHANT_CODE=
IPAY88_MERCHANT_KEY=

# ─── Delivery (Phase 2 — optional) ──────────────────────────────────────────────
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_ENVIRONMENT=sandbox   # Switch to 'production' when live

# ─── Marketing integrations (Phase 2) ───────────────────────────────────────────
BUFFER_ACCESS_TOKEN=
MAILERLITE_API_KEY=
GOOGLE_BUSINESS_API_KEY=

# ─── App ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=                       # Your Railway/Render deployment URL (e.g. https://naik.up.railway.app)
